config eproxy 'main'
	option enabled '0'
	option engine 'native'
	option enable_tun '0'
	option dns_strategy 'prefer_ipv4'
	option dns_remote '1.1.1.1'
	option dns_server_name 'cloudflare-dns.com'
	option tun_interface 'br-lan'
	option listen '127.0.0.1:1080'
	option default_outbound 'direct'
	option dial_timeout_seconds '10'

config outbound 'direct'
	option type 'direct'
