#!/bin/sh /etc/rc.common

USE_PROCD=1
START=93
STOP=15

start_service() {
	local enabled
	config_load eproxy
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	[ -x /usr/bin/eproxy ] || { logger -t eproxy "binary not installed"; return 1; }
	# Same UCI data is consumed by the LuCI form and the daemon.
	# Never interpolate untrusted credentials into a shell command.
	# UCI writes by LuCI can replace the file; enforce root-only secrets.
	chmod 0600 /etc/config/eproxy || return 1
	/usr/bin/eproxy -uci /etc/config/eproxy -check-config || {
		logger -t eproxy "invalid UCI config; refusing to start"
		return 1
	}
	procd_open_instance
	procd_set_param command /usr/bin/eproxy -uci /etc/config/eproxy
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/eproxy
	procd_set_param limits core="0"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "eproxy"
}
