#!/bin/sh /etc/rc.common

USE_PROCD=1
START=93
STOP=15

start_service() {
	local enabled addr
	config_load eproxy
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get addr main listen "127.0.0.1:1080"
	case "$addr" in
		127.*:*|'[::1]':*|localhost:*) ;;
		*) logger -t eproxy "non-loopback listen address denied"; return 1 ;;
	esac
	[ -x /usr/bin/eproxy ] || return 1

	procd_open_instance
	procd_set_param command /usr/bin/eproxy -listen "$addr"
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/eproxy
	procd_set_param limits core="0"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "eproxy"
}
