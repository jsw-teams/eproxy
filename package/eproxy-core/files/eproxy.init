#!/bin/sh /etc/rc.common

USE_PROCD=1
START=93
STOP=15

start_service() {
	local enabled addr config_path
	config_load eproxy
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get addr main listen "127.0.0.1:1080"
	config_get config_path main config_path "/etc/eproxy/config.json"
	case "$addr" in
		127.*:*|'[::1]':*|localhost:*) ;;
		*) logger -t eproxy "non-loopback address denied"; return 1 ;;
	esac
	case "$config_path" in
		/etc/eproxy/*.json) ;;
		*) logger -t eproxy "config must be in /etc/eproxy/"; return 1 ;;
	esac
	[ -x /usr/bin/eproxy ] || return 1
	[ -f "$config_path" ] || {
		logger -t eproxy "configure a private JSON first; eproxy remains disabled"
		return 1
	}
	/usr/bin/eproxy -config "$config_path" -listen "$addr" -check-config || {
		logger -t eproxy "invalid config; refusing to start"
		return 1
	}
	procd_open_instance
	procd_set_param command /usr/bin/eproxy -config "$config_path" -listen "$addr"
	procd_set_param respawn 3600 5 5
	procd_set_param file /etc/config/eproxy "$config_path"
	procd_set_param limits core="0"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "eproxy"
}
